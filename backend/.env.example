# 复制为 .env 并填入真实密钥（.env 已被 .gitignore 排除）
#
# 接口是标准 **OpenAI 兼容**协议（POST {LLM_BASE_URL}/chat/completions
# + Authorization: Bearer {key}），所以**任何厂商的 key 都能用**。
# 变量名与厂商无关：LLM_API_KEY 是通用名；QWEN_API_KEY / DASHSCOPE_API_KEY
# 只是历史别名，仍然可用。
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 换厂商：只要改下面两行（不改也能跑，默认通义千问）----
# 通义千问 / 阿里百炼   https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
# DeepSeek             https://api.deepseek.com/v1                        deepseek-chat
# 月之暗面 Kimi         https://api.moonshot.cn/v1                          moonshot-v1-8k
# 智谱 GLM              https://open.bigmodel.cn/api/paas/v4                glm-4-flash
# 硅基流动              https://api.siliconflow.cn/v1                       Qwen/Qwen2.5-7B-Instruct
# OpenAI               https://api.openai.com/v1                          gpt-4o-mini
# 本地 Ollama          http://localhost:11434/v1                          qwen2.5:7b
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ---- 不填密钥也能跑 ----
# 留空 LLM_API_KEY（或直接删除本文件）时，所有依赖模型的环节走确定性兜底，
# 计划、两版工期、定额锚定、Word 与看板照常产出。
# PORT=8000
